# =============================================
# Len Em - Yarn Shop Frontend Environment
# =============================================
# Copy this file to .env and fill in the values
# cp .env.example .env
# =============================================

# ─── API Configuration ────────────────────────
# Base URL for the backend API
# For development, Vite proxies /api to the backend,
# so you can leave this empty or set to the dev server.
VITE_API_BASE_URL=

# ─── Production API Configuration ────────────
# Copy this to .env.production for production builds
# VITE_API_BASE_URL=https://yarn-shop-be.onrender.com/api/v1